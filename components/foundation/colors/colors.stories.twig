          <tr>
            <td>emphasis</td>
            <td><span class="token-swatch" style="background-color: var(--bs-success-text-emphasis);"></span></td>
          </tr>
          <tr>
            <td>subtle</td>
            <td><span class="token-swatch" style="background-color: var(--bs-success-bg-subtle);"></span></td>
          </tr>
          <tr>
            <td>border</td>
            <td><span class="token-swatch swatch-border" style="background-color: var(--bs-success-border-subtle);"></span></td>
