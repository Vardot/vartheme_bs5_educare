  <div class="row mt-3">
    <div class="col">
      <table class="token-table">
        <thead>
          <tr>
            <th>info/</th>
            <th>sample</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>info</td>
            <td><span class="token-swatch" style="background-color: var(--bs-info);"></span></td>
          </tr>
          <tr>
