        </thead>
        <tbody>
          <tr>
            <td>subtle-border</td>
            <td><span class="token-swatch swatch-border" style="background-color: var(--bs-border-color);"></span></td>
            <td>Used for borders on the light bg</td>
          </tr>
          <tr>
            <td>dark-border</td>
            <td><span class="token-swatch" style="background-color: #404456;"></span></td>
            <td>Used for borders on the dark backgrounds</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  {# Subtle tokens #}
  <div class="row mt-5 pt-5">
    <div class="col pt-5 border-top border-light-subtle">
      <h2>Subtle</h2>
