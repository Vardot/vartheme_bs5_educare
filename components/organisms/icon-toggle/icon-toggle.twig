{#
/**
 * @file
 * Vartheme BS5 Educare Starter Kit implementation for the Icon Toggle component.
 *
 * A single icon button, meant to sit at the end of the header/navbar (or
 * anywhere else). Clicking it reveals a popover panel holding whatever is
 * dropped into the "content" slot, overlaid over the page so sibling
 * elements (e.g. the main menu) stay visible the whole time; clicking it
 * again (now showing a close icon), pressing Escape, or clicking outside
 * closes the panel.
 *
 * Available properties:
 * - icon: Bootstrap Icon name shown in the closed state. Swaps to a close
 *         (X) icon while the panel is open. Defaults to `search`.
 * - label: Label for the closed state. Visually hidden unless `show_label`.
 *          Defaults to `Search`.
 * - open_label: Label announced (and shown, with `show_label`) while the panel
 *               is open. Defaults to `Close search`.
 * - show_label: Print the label next to the icon instead of only exposing it to
 *               assistive technology. Defaults to `false`.
 * - placement: Which side the popover panel aligns to. (end | start)
 *              Defaults to `end`.
 * - panel: How the revealed panel looks — a boxed popover below the button, or
 *          an inline bar on one hairline-underlined line carrying the icon, the
 *          field and its own close button. (popover | bar) Defaults to
 *          `popover`.
 *
 * Available attributes:
 * - attributes: HTML attributes for the root element.
 * - button_attributes: HTML attributes for the trigger button.
 * - label_attributes: HTML attributes for the trigger's label text.
 * - panel_attributes: HTML attributes for the revealed panel.
 * - close_attributes: HTML attributes for the inline bar's own close button.
 * - inner_attributes: HTML attributes for the panel's inner row.
 * - placeholder_attributes: HTML attributes for the empty-slot placeholder.
 *
 * Available slots:
 * - content: The content revealed in the popover.
 */
#}

{# AI guidance:
 # - Do not alter property descriptions or existing logic unless new
 #   properties are added.
 # - Keep the structure: 1) variables, 2) logical variable manipulations,
 #   3) print the HTML.
 # - Always handle classes as arrays with `merge` (never string
 #   concatenation) to avoid duplicate classes and data type conflicts.
 #}

{# Variables: scalar props with schema defaults. #}
{% set icon = icon|default('search') %}
{% set label = label|default('Search'|t) %}
{% set open_label = open_label|default('Close search'|t) %}
{% set placement = placement|default('end') %}
{% set panel = panel|default('popover') %}
{% set show_label = show_label is defined ? show_label : false %}
{% set expand_in_editor = expand_in_editor is defined ? expand_in_editor : true %}

{# Logic: merge root classes as an array. Bootstrap's `dropdown` carries the
 # positioning context its Dropdown plugin expects. #}
{% set classes = [
  'icon-toggle',
  'dropdown',
  'icon-toggle--' ~ placement,
  'icon-toggle--panel-' ~ panel,
  show_label ? 'icon-toggle--labelled',
]|filter(v => v is not empty) %}

{# Logic: static structural class lists and a unique panel id. The panel is a
 # Bootstrap `dropdown-menu`, so Bootstrap owns showing and hiding it, the
 # `aria-expanded` state, Escape, outside clicks and returning focus to the
 # trigger. `dropdown-menu-end` is Bootstrap's own end-side alignment. #}
{% set button_classes = ['icon-toggle__button'] %}
{# The label rides the header's own `navbar-expand-lg` breakpoint: shown beside
 # the icon once the menu is a row, hidden while the header is an icon line. #}
{% set label_classes = ['icon-toggle__label', 'd-none', 'd-lg-inline'] %}
{% set close_classes = ['icon-toggle__close'] %}
{% set inner_classes = ['icon-toggle__panel-inner'] %}
{% set placeholder_classes = ['icon-toggle__placeholder', 'text-muted', 'mb-0'] %}
{% set panel_classes = ['icon-toggle__panel', 'dropdown-menu'] %}
{% if placement == 'end' %}
  {% set panel_classes = panel_classes|merge(['dropdown-menu-end']) %}
{% endif %}
{# Logic: `expand_in_editor: false` opts this instance out of the Canvas
 # editor's always-open preview once its slot has content — icon-toggle.js
 # reads the modifier. Front-end behavior is unaffected. #}
{% if not expand_in_editor %}
  {% set classes = classes|merge(['icon-toggle--collapsed-in-editor']) %}
{% endif %}

{% set panel_id = 'icon-toggle-panel-' ~ random(99999) %}

{# Slot content. Checked for emptiness (not just block-default) because
 # Canvas passes an empty string for an unfilled slot, which would otherwise
 # silently win over a default placeholder written inside the block. #}
{% set panel_content %}{% block content %}{% endblock %}{% endset %}
{% set has_content = panel_content|trim is not empty %}

{# Logic: nested attribute objects, classes merged before any other setter. #}
{% if not button_attributes %}
  {% set button_attributes = create_attribute() %}
{% endif %}
{% set button_attributes = button_attributes.addClass(button_classes)
  .setAttribute('type', 'button')
  .setAttribute('data-bs-toggle', 'dropdown')
  .setAttribute('aria-expanded', 'false')
  .setAttribute('aria-controls', panel_id)
  .setAttribute('data-icon-toggle-open-label', open_label)
  .setAttribute('aria-label', label) %}
{# The bar spans the band it sits in, so Popper's positioning is not wanted. #}
{% if panel == 'bar' %}
  {% set button_attributes = button_attributes.setAttribute('data-bs-display', 'static') %}
{% endif %}

{% if not label_attributes %}
  {% set label_attributes = create_attribute() %}
{% endif %}
{% set label_attributes = label_attributes.addClass(label_classes) %}

{% if not panel_attributes %}
  {% set panel_attributes = create_attribute() %}
{% endif %}
{% set panel_attributes = panel_attributes.addClass(panel_classes).setAttribute('id', panel_id) %}

{% if not close_attributes %}
  {% set close_attributes = create_attribute() %}
{% endif %}
{% set close_attributes = close_attributes.addClass(close_classes)
  .setAttribute('type', 'button')
  .setAttribute('aria-controls', panel_id)
  .setAttribute('aria-label', open_label) %}

{% if not inner_attributes %}
  {% set inner_attributes = create_attribute() %}
{% endif %}
{% set inner_attributes = inner_attributes.addClass(inner_classes) %}

{% if not placeholder_attributes %}
  {% set placeholder_attributes = create_attribute() %}
{% endif %}
{% set placeholder_attributes = placeholder_attributes.addClass(placeholder_classes) %}

{# Print the HTML. #}
{% set attributes = attributes.addClass(classes) %}
<div{{ attributes }}>
  <button{{ button_attributes }}>
    {{ include('vartheme_bs5_educare:bootstrap-icon', {
      icon: icon,
      icon_size: 'fs-4',
      attributes: create_attribute().addClass('icon-toggle__icon'),
    }, with_context = false) }}
    {% if show_label %}
      <span{{ label_attributes }}>{{ label }}</span>
    {% endif %}
  </button>

  <div{{ panel_attributes }}>
    <div{{ inner_attributes }}>
      {% if has_content %}
        {{ panel_content }}
      {% else %}
        <p{{ placeholder_attributes }}>{{ 'Drop content here.'|t }}</p>
      {% endif %}
      {% if panel == 'bar' %}
        <button{{ close_attributes }}>
          {{ include('vartheme_bs5_educare:bootstrap-icon', {
            icon: 'x-lg',
            icon_size: 'fs-6',
            attributes: create_attribute().addClass('icon-toggle__close-icon'),
          }, with_context = false) }}
        </button>
      {% endif %}
    </div>
  </div>
</div>
