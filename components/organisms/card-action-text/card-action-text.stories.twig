{% stories CardActionText with {
  title: 'Cards/Action Card Text',
  parameters: {
    componentSubtitle: 'Text card with an animated Bootstrap action icon (accent circle-fill + arrow rotate on hover) and a flexible drag-and-drop content slot.',
    docs: {
      description: {
        component: 'A stacked text card featuring a Bootstrap arrow icon (bi-arrow-right) floated to the top-right corner in a white circle, and a single drag-and-drop content slot. Hovering the card fills the circle with the theme accent colour and rotates the arrow from -45deg (up-right) to 0deg (right). Drop any components (heading, text, button, etc.) into the content area. Inherits all standard card styling options: background color, border, shadow, corner radius, equal height, and stretched link.',
      },
      story: {
        inline: true,
      },
    },
  },
  argTypes: {
    card_border: {
      name: 'Card border',
      description: 'Adds default Bootstrap border.',
      defaultValue: false,
      control: 'boolean',
    },
    background_color: {
      name: 'Background',
      description: 'Brand background color applied to the card.',
      defaultValue: 'none',
      control: 'select',
      options: {
        None: 'none',
        "'Body tertiary'": 'bg-body-tertiary',
        Tertiary: 'bg-tertiary',
        Accent: 'bg-accent',
        Primary: 'bg-primary',
        "'Primary subtle'": 'bg-primary-subtle',
        Secondary: 'bg-secondary',
        "'Secondary subtle'": 'bg-secondary-subtle',
        Dark: 'bg-dark',
      },
    },
    padded: {
      name: 'Padded',
      description: 'Adds p-4 spacing to the card body.',
      defaultValue: false,
      control: 'boolean',
    },
    box_shadow: {
      name: 'Shadow',
      description: 'Bootstrap shadow utility.',
      defaultValue: 'shadow-none',
      control: 'select',
      options: {
        None: 'shadow-none',
        Small: 'shadow-sm',
        Medium: 'shadow',
        Large: 'shadow-lg',
      },
    },
    corner_style: {
      name: 'Border radius',
      description: 'Rounded utility for the card.',
      defaultValue: 'rounded-0',
      control: 'select',
      options: {
        "'None (square)'": 'rounded-0',
        Small: 'rounded-1',
        Medium: 'rounded-2',
        Large: 'rounded-3',
        "'Extra Large'": 'rounded-4',
        Pill: 'rounded-pill',
      },
    },
    equal_height: {
      name: 'Equal height',
      description: 'Apply h-100 for grid alignment.',
      defaultValue: false,
      control: 'boolean',
    },
    stretched_link: {
      name: 'Stretched link',
      description: 'Make the entire card clickable.',
      defaultValue: false,
      control: 'boolean',
    },
    link_url: {
      name: 'Link URL',
      description: 'Optional card link URL.',
      defaultValue: '',
      control: 'text',
    },
    link_target: {
      name: 'Link target',
      description: 'Target attribute for the card link.',
      defaultValue: 'default',
      control: 'select',
      options: {
        "'Default (same tab)'": 'default',
        "'Same tab'": '_self',
        "'New tab'": '_blank',
      },
    },
  },
} %}

{# ── Story 1: Light background ── #}
{% story Default with {
  name: 'Default',
  args: {
    card_border: false,
    background_color: 'bg-body-tertiary',
    padded: true,
    box_shadow: 'shadow-none',
    corner_style: 'rounded-3',
    equal_height: false,
    stretched_link: false,
    link_url: '',
    link_target: 'default',
  },
} %}
{% embed 'vartheme_bs5_educare:card-action-text' with _context %}
  {% block content %}
    <strong class="d-block h5 mb-4">Title card</strong>
    <p class="mb-0 opacity-75 small">Description text</p>
  {% endblock %}
{% endembed %}
{% endstory %}

