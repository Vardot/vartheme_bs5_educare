{#
/**
 * @file
 * Vartheme BS5 Educare Starter Kit implementation for the Figure component.
 *
 * Stat figure card with a vertical border accent, large number,
 * optional superscript suffix, and description text.
 * Background, font sizes, and text colours are all configurable via
 * Bootstrap utilities — no custom CSS.
 *
 * - The number counts up from 0 when it scrolls into view (progressive
 *   enhancement: renders as the final number and is fully usable without
 *   JS; respects prefers-reduced-motion). See figure.js.
 *
 * Available properties:
 * - number: The main statistic number displayed prominently. (required)
 * - suffix: Optional superscript character after the number. Defaults to `+`.
 * - description: Short descriptive label below the number. (required)
 * - background_color: Bootstrap bg-* utility for the card root.
 *                     (bg-body | bg-body-secondary | bg-body-tertiary
 *                      | bg-primary | bg-primary-subtle | bg-secondary
 *                      | bg-secondary-subtle | bg-success | bg-success-subtle
 *                      | bg-danger | bg-danger-subtle | bg-warning
 *                      | bg-warning-subtle | bg-info | bg-info-subtle
 *                      | bg-light | bg-dark | bg-dark-subtle | bg-black
 *                      | bg-white | bg-transparent) Defaults to `bg-dark`.
 * - number_size: Bootstrap display-* utility for the number.
 *                (display-1 | display-2 | display-3 | display-4
 *                 | display-5 | display-6) Defaults to `display-1`.
 * - number_color: Bootstrap text colour for the number.
 *                 (text-body | text-primary | text-secondary | text-success
 *                  | text-danger | text-warning | text-info | text-light
 *                  | text-dark | text-muted | text-white | text-white-50
 *                  | text-black | text-black-50) Defaults to `text-white`.
 * - suffix_color: Bootstrap text colour for the superscript suffix.
 *                 Same enum as number_color. Defaults to `text-white-50`.
 * - description_size: Bootstrap fs-* utility for the description.
 *                     (fs-1 | fs-2 | fs-3 | fs-4 | fs-5 | fs-6)
 *                     Defaults to `fs-6`.
 * - description_color: Bootstrap text colour for the description label.
 *                      Same enum as number_color. Defaults to `text-white-50`.
 *
 * Available attributes:
 * - attributes: HTML attributes for the root element.
 * - content_attributes: HTML attributes for the border-accent content wrapper.
 */
#}

{# AI guidance:
 # - Do not alter property descriptions or existing logic unless new
 #   properties are added.
 # - Keep the structure: 1) variables, 2) logical variable manipulations,
 #   3) print the HTML.
 # - Always handle classes as arrays with `merge` (never string
 #   concatenation) to avoid duplicate classes and data type conflicts.
 #}

{# Variables: scalar props with schema defaults. #}
{% set suffix           = suffix|default('+') %}
{% set background_color = background_color|default('bg-dark') %}
{% set number_size      = number_size|default('display-1') %}
{% set number_color     = number_color|default('text-white') %}
{% set suffix_color     = suffix_color|default('text-white-50') %}
{% set description_size = description_size|default('fs-6') %}
{% set description_color = description_color|default('text-white-50') %}

{# Logic: root classes — Bootstrap utilities only, no custom CSS. #}
{% set classes = [
  'figure',
  background_color,
  'p-4',
  'p-lg-5',
] %}

{# Logic: per-region attributes for the border-accent content wrapper. #}
{% if not content_attributes %}
  {% set content_attributes = create_attribute() %}
{% endif %}
{% set content_classes = [
  'd-flex',
  'flex-column',
  'border-start',
  'border-2',
  'border-white',
  'border-opacity-25',
  'ps-3',
] %}
{% set content_attributes = content_attributes.addClass(content_classes) %}

{# Logic: number, suffix, and description class lists. #}
{% set number_classes = [number_size, number_color, 'lh-1'] %}
{% set suffix_classes = ['fs-3', 'fw-semibold', suffix_color, 'mt-2'] %}
{% set description_classes = [description_size, description_color, 'mb-0', 'mt-2'] %}

{# Print the HTML. #}
{% set attributes = attributes.addClass(classes) %}
<div{{ attributes }}>
  <div{{ content_attributes }}>

    <div class="d-flex align-items-start">
      <span class="{{ number_classes|join(' ') }}" data-count-target="{{ number|e }}">{{ number|e }}</span>
      {% if suffix %}
        <sup class="{{ suffix_classes|join(' ') }}">{{ suffix|e }}</sup>
      {% endif %}
    </div>

    <p class="{{ description_classes|join(' ') }}">{{ description|e }}</p>

  </div>
</div>
